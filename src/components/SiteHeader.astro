---
import { LOCALES, person, type Locale } from "../data/cv";
import { routes, routeById, localeNames } from "../i18n/routes";
import { ui } from "../i18n/ui";

interface Props {
  locale: Locale;
  routeId: string;
}

const { locale, routeId } = Astro.props;
const current = routeById(routeId);
---

<header class="site-header">
  <div class="wrapper site-header__inner">
    <a class="site-header__name" href={routeById("home").path[locale]}>
      {person.name}
    </a>

    <nav aria-label={ui.mainNav[locale]}>
      <ul class="nav-list">
        {
          routes.map((route) => (
            <li>
              <a
                href={route.path[locale]}
                aria-current={route.id === routeId ? "page" : undefined}
              >
                {route.label[locale]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label={ui.langNav[locale]}>
      <ul class="lang-switch">
        {
          LOCALES.map((l) => (
            <li>
              <a
                href={current.path[l]}
                hreflang={l}
                lang={l}
                aria-current={l === locale ? "true" : undefined}
              >
                <span class="visually-hidden">{localeNames[l]}</span>
                <span aria-hidden="true">{l}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
