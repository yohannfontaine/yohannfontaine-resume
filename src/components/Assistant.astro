---
import type { Locale } from "../data/cv";
import { ui } from "../i18n/ui";
import { assistants, assistantUrl, condensedProfile } from "../lib/profile";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = Astro.site?.href ?? "https://yohannfontaine-resume.web.app/";
const prompt = condensedProfile(locale, site);
---

<section class="assistant" aria-labelledby="assistant-title">
  <h2 id="assistant-title">{ui.assistantTitle[locale]}</h2>
  <p>{ui.assistantIntro[locale]}</p>

  <div class="assistant__actions">
    {
      assistants.map((a) => (
        <a class="button" href={assistantUrl(a.base, prompt)} rel="noopener">
          {a.label}
        </a>
      ))
    }
  </div>

  {/* Si le paramètre d'URL ne passe pas, ou si l'assistant du visiteur n'est
      pas dans la liste, le texte reste copiable à la main. */}
  <details>
    <summary>{ui.assistantFallback[locale]}</summary>
    <pre>{prompt}</pre>
  </details>
</section>
